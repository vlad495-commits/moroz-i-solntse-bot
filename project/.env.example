PUBLIC_DOMAIN=bot.example.ru
PUBLIC_BASE_URL=https://bot.example.ru

POSTGRES_USER=moroz
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=moroz

REDIS_PASSWORD=replace-with-strong-redis-password
REDIS_URL=redis://:replace-with-strong-redis-password@redis:6379/0

RABBITMQ_USER=moroz
RABBITMQ_PASSWORD=replace-with-strong-rabbitmq-password
RABBITMQ_URL=amqp://moroz:replace-with-strong-rabbitmq-password@rabbitmq:5672/
RABBITMQ_METRICS_URL=http://rabbitmq:15692

TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-strong-webhook-secret
POLICY_URL=https://bot.example.ru/privacy
TECHNICAL_ALERT_CHAT_ID=replace-with-technical-chat-id
BUSINESS_ALERT_CHAT_ID=

# Local admin bootstrap is disabled. Staging credentials live only on the server.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_COOKIE_SECURE=true
ADMIN_SESSION_TTL_SEC=86400
ADMIN_PORT=8080

LLM_API_KEY=replace-with-llm-api-key
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4.1-mini
RESERVE_API_KEY=
RESERVE_BASE_URL=
RESERVE_MODEL=
COMPACT_MODEL=
COMPACT_API_KEY=
COMPACT_BASE_URL=
COMPACT_MAX_TOKENS=400
COMPACT_THRESHOLD=30
COMPACT_KEEP_RECENT=10
CONTEXT_MESSAGES_LIMIT=40

YCLIENTS_CATALOG_GROUNDING_ENABLED=false
YCLIENTS_PARTNER_TOKEN=replace-with-yclients-partner-token
YCLIENTS_USER_TOKEN=replace-with-yclients-user-token
YCLIENTS_COMPANY_ID=replace-with-yclients-company-id
YCLIENTS_BASE_URL=https://api.yclients.com
YCLIENTS_TIMEZONE=Europe/Moscow
YCLIENTS_TIMEOUT_SECONDS=10

BACKUP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400
BACKUP_TMPFS_SIZE=1g
